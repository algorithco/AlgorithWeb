FROM node:22.20.0-bookworm-slim AS build

WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts

COPY . .

ARG NEXT_PUBLIC_SITE_URL=https://trqsh.uz
ARG NEXT_PUBLIC_VOICE_URL=https://voice.algorithco.com
ARG NEXT_PUBLIC_GUARD_URL=https://trqsh.uz/app/guard
ARG NEXT_PUBLIC_ACCOUNT_ISSUER=https://trqsh.uz/account
ARG NEXT_PUBLIC_ACCOUNT_CLIENT_ID=algorithco-platform-web
ARG NEXT_PUBLIC_ACCOUNT_REDIRECT_URI=https://trqsh.uz/auth/callback
ARG NEXT_PUBLIC_ACCOUNT_BILLING_URL=https://trqsh.uz/account
ARG NEXT_PUBLIC_GUARD_API_BASE=/api/guard
ARG NEXT_PUBLIC_ACCOUNT_API_BASE=/api/account
ARG NEXT_PUBLIC_VOICE_API_BASE=/api/voice
ARG NEXT_PUBLIC_CONTACT_EMAIL=
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_VOICE_URL=$NEXT_PUBLIC_VOICE_URL \
    NEXT_PUBLIC_GUARD_URL=$NEXT_PUBLIC_GUARD_URL \
    NEXT_PUBLIC_ACCOUNT_ISSUER=$NEXT_PUBLIC_ACCOUNT_ISSUER \
    NEXT_PUBLIC_ACCOUNT_CLIENT_ID=$NEXT_PUBLIC_ACCOUNT_CLIENT_ID \
    NEXT_PUBLIC_ACCOUNT_REDIRECT_URI=$NEXT_PUBLIC_ACCOUNT_REDIRECT_URI \
    NEXT_PUBLIC_ACCOUNT_BILLING_URL=$NEXT_PUBLIC_ACCOUNT_BILLING_URL \
    NEXT_PUBLIC_GUARD_API_BASE=$NEXT_PUBLIC_GUARD_API_BASE \
    NEXT_PUBLIC_ACCOUNT_API_BASE=$NEXT_PUBLIC_ACCOUNT_API_BASE \
    NEXT_PUBLIC_VOICE_API_BASE=$NEXT_PUBLIC_VOICE_API_BASE \
    NEXT_PUBLIC_CONTACT_EMAIL=$NEXT_PUBLIC_CONTACT_EMAIL

RUN pnpm build

FROM nginx:1.29-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/out /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --retries=5 CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
