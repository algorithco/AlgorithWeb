# Canonical public URL for this website.
NEXT_PUBLIC_SITE_URL=https://trqsh.uz

# External product destinations.
NEXT_PUBLIC_VOICE_URL=https://trqsh.uz/app/voice
NEXT_PUBLIC_GUARD_URL=https://trqsh.uz/app/guard

# Central account-system origin. Canonical issuer is https://trqsh.uz/account.
# One company account (algorithco-platform-web) serves Voice, Guard, billing.
NEXT_PUBLIC_ACCOUNT_ISSUER=https://trqsh.uz/account
NEXT_PUBLIC_ACCOUNT_CLIENT_ID=algorithco-platform-web
NEXT_PUBLIC_ACCOUNT_REDIRECT_URI=https://trqsh.uz/auth/callback
NEXT_PUBLIC_ACCOUNT_BILLING_URL=https://trqsh.uz/account
# One frontend, multiple backends (same-origin Nginx gateway).
NEXT_PUBLIC_GUARD_API_BASE=/api/guard
NEXT_PUBLIC_ACCOUNT_API_BASE=/api/account
NEXT_PUBLIC_VOICE_API_BASE=/api/voice

# Leave empty to hide the email address on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=
